{
  "name": "hacienda-backend",
  "version": "0.1.0",
  "description": "Hacienda Backend MCP Extension for Claude Desktop",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "mcp": {
    "name": "hacienda-backend",
    "version": "0.1.0",
    "description": "Closed-manifest MCP access to tokenized search, sync, status, document references, and optional graph retrieval",
    "capabilities": ["tools", "resources"],
    "tools": [
      "search",
      "sync",
      "status",
      "attach_local_doc",
      "graph_entities",
      "graph_rag"
    ],
    "resources": [
      "basemind://status",
      "basemind://repo/map"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
